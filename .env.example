# Use a dedicated MySQL application user; never put root credentials here.
DATABASE_URL=mysql+pymysql://careerpath_app:CHANGE_ME@127.0.0.1:3306/careerpath
CAREERPATH_DB=careerpath.sqlite3
PORT=5000
ADMIN_EMAIL=admin@example.com
# First-admin bootstrap requires at least 12 characters. Change before use.
ADMIN_PASSWORD=admin@123
